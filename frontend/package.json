{
  "name": "portalrh-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Modern React frontend for PortalRH - Human Resources Management System",
  "dependencies": {
    "@headlessui/react": "^2.2.7",
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^5.2.1",
    "axios": "^1.11.0",
    "chart.js": "^4.5.0",
